        <mxCell id="el8" value="сверка" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=19;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1140" y="170" width="71.0" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lis" value="1. Готовый результат в LIS&#10;resultId / patientId / version&#10;Точка начала гарантии" style="whiteSpace=wrap;html=0;fillColor=#f1f3f6;strokeColor=#48617f;fontSize=20;align=left;spacing=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="capture" value="2. REST capture / сверка&#10;Страница изменений + overlap&#10;API изменений надо согласовать" style="whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#48617f;fontSize=20;align=left;spacing=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="650" y="140" width="460" height="130" as="geometry" />
        </mxCell>
        <mxCell id="spool" value="3. Durable spool + outbox&#10;Payload и cursor одним commit&#10;Повтор захвата безопасен" style="whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#48617f;fontSize=20;align=left;spacing=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="650" y="420" width="460" height="130" as="geometry" />
        </mxCell>
        <mxCell id="broker" value="4. RabbitMQ quorum queues&#10;Persistent + confirms + routing&#10;Отдельные CRM / notify очереди" style="whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#48617f;fontSize=20;align=left;spacing=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="650" y="700" width="460" height="130" as="geometry" />
        </mxCell>
        <mxCell id="crm" value="5. CRM consumer&#10;Inbox + version + upsert + outbox&#10;Ack после commit" style="whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#48617f;fontSize=20;align=left;spacing=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="80" y="700" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="app" value="6. Приложение читает CRM&#10;REST через платформу / auth&#10;Проверка patient и version" style="whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#48617f;fontSize=20;align=left;spacing=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="80" y="1030" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dlq" value="DLQ / карантин / оператор&#10;Transient retry: 1/5/30/120/300 с&#10;Затем исправление и replay" style="whiteSpace=wrap;html=0;fillColor=#fff0cf;strokeColor=#48617f;fontSize=20;align=left;spacing=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1250" y="700" width="460" height="130" as="geometry" />
        </mxCell>
        <mxCell id="push" value="7. Уведомления&#10;ResultAvailable после commit&#10;Push не содержит сам результат" style="whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#48617f;fontSize=20;align=left;spacing=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="650" y="1030" width="460" height="130" as="geometry" />
        </mxCell>
        <mxCell id="recon" value="Контроль полноты&#10;LIS manifest ↔ spool ↔ CRM&#10;Повторный захват пропусков" style="whiteSpace=wrap;html=0;fillColor=#fff0cf;strokeColor=#48617f;fontSize=20;align=left;spacing=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1250" y="140" width="460" height="130" as="geometry" />
        </mxCell>
        <mxCell id="foot0" value="Отказ CRM не теряет outbox. Повтор после commit/ack безопасен по resultId/version." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=19;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="1245" width="1720" height="25" as="geometry" />
        </mxCell>
        <mxCell id="foot1" value="Недоступный change API без полного manifest - блокер доказательства полноты." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=19;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="1271" width="1720" height="25" as="geometry" />
        </mxCell>
      </root>
